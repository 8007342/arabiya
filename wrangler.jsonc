{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arabiya",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "arabiya.tlatoani.net",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "build/worker/index.mjs",
  "vars": {
    "APP_DOMAIN": "arabiya.tlatoani.net",
    // Public Google OAuth web client ID. Register this app origin in Google Cloud.
    // The same Worker deploys /api/auth/google; no separate callback service.
    "GOOGLE_CLIENT_ID": "490204137466-0ijru4uds6p3hdnfa66t4gti5ffhephm.apps.googleusercontent.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARABIYA_STATE",
        "class_name": "ArabiyaState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArabiyaState"
      ]
    }
  ]
}
